{
  "openapi": "3.1.0",
  "info": {
    "title": "Resident",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/ingest/healthkit": {
      "post": {
        "tags": [
          "ingest"
        ],
        "summary": "Ingest Healthkit",
        "operationId": "ingest_healthkit_api_ingest_healthkit_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HealthKitBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "tags": [
          "observations"
        ],
        "summary": "List Metrics",
        "operationId": "list_metrics_api_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MetricSummary"
                  },
                  "type": "array",
                  "title": "Response List Metrics Api Metrics Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics/{metric}/observations": {
      "get": {
        "tags": [
          "observations"
        ],
        "summary": "Get Observations",
        "operationId": "get_observations_api_metrics__metric__observations_get",
        "parameters": [
          {
            "name": "metric",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Metric"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Since"
            }
          },
          {
            "name": "until",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Until"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 500,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ObservationOut"
                  },
                  "title": "Response Get Observations Api Metrics  Metric  Observations Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/audit": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Get Audit Log",
        "description": "Recent accesses to health data. Reading the log is itself not audited.",
        "operationId": "get_audit_log_api_audit_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 200,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AuditEventOut"
                  },
                  "title": "Response Get Audit Log Api Audit Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuditEventOut": {
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time",
            "title": "At"
          },
          "actor": {
            "type": "string",
            "title": "Actor"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "target": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          },
          "result_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result Count"
          }
        },
        "type": "object",
        "required": [
          "at",
          "actor",
          "action",
          "target",
          "result_count"
        ],
        "title": "AuditEventOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthKitBatch": {
        "properties": {
          "samples": {
            "items": {
              "$ref": "#/components/schemas/HealthKitSample"
            },
            "type": "array",
            "title": "Samples"
          }
        },
        "type": "object",
        "required": [
          "samples"
        ],
        "title": "HealthKitBatch"
      },
      "HealthKitSample": {
        "properties": {
          "uuid": {
            "type": "string",
            "title": "Uuid"
          },
          "type": {
            "type": "string",
            "title": "Type",
            "description": "HealthKit type identifier, e.g. HKQuantityTypeIdentifierHeartRate"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          },
          "source_name": {
            "type": "string",
            "title": "Source Name"
          }
        },
        "type": "object",
        "required": [
          "uuid",
          "type",
          "value",
          "unit",
          "start",
          "end",
          "source_name"
        ],
        "title": "HealthKitSample",
        "description": "One HealthKit sample as sent by the iOS companion app."
      },
      "IngestResult": {
        "properties": {
          "received": {
            "type": "integer",
            "title": "Received"
          },
          "stored": {
            "type": "integer",
            "title": "Stored"
          },
          "skipped_unknown": {
            "type": "integer",
            "title": "Skipped Unknown"
          }
        },
        "type": "object",
        "required": [
          "received",
          "stored",
          "skipped_unknown"
        ],
        "title": "IngestResult"
      },
      "MetricSummary": {
        "properties": {
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "latest_at": {
            "type": "string",
            "format": "date-time",
            "title": "Latest At"
          }
        },
        "type": "object",
        "required": [
          "metric",
          "name",
          "unit",
          "count",
          "latest_at"
        ],
        "title": "MetricSummary"
      },
      "ObservationOut": {
        "properties": {
          "metric": {
            "type": "string",
            "title": "Metric"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "value_text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value Text"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "start_at": {
            "type": "string",
            "format": "date-time",
            "title": "Start At"
          },
          "end_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "End At"
          }
        },
        "type": "object",
        "required": [
          "metric",
          "value",
          "value_text",
          "unit",
          "start_at",
          "end_at"
        ],
        "title": "ObservationOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
