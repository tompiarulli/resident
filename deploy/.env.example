# Copy to deploy/.env on the server host. Never commit the real file.

# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Tailscale auth key for the sidecar: admin console > Settings > Keys. Use a tagged key
# (tag:resident) so the node is owned by the tag, not your user.
TS_AUTHKEY=
TS_HOSTNAME=resident
# Your tailnet's MagicDNS suffix, e.g. tail1234.ts.net (admin console > DNS)
TS_TAILNET=

# Your Tailscale login(s), comma-separated, allowed to use the dashboard, e.g. you@github
RESIDENT_TRUSTED_TAILSCALE_LOGINS=
